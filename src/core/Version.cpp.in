// Version.cpp — generated by CMake from Version.cpp.in.
//
// The @-substituted values are captured at configure time:
//   * @PROJECT_VERSION_MAJOR@ / _MINOR / _PATCH — from project(VERSION ...)
//   * @VERITAS_GIT_REVISION@ — short SHA of HEAD via `git rev-parse --short`
//
// Reconfigure to refresh the git revision.

#include "veritas/core/Version.h"

#include <sstream>

namespace veritas {

Version GetVersion() {
  return Version{
      @PROJECT_VERSION_MAJOR@,
      @PROJECT_VERSION_MINOR@,
      @PROJECT_VERSION_PATCH@,
      "@VERITAS_GIT_REVISION@",
  };
}

std::string FormatVersion(const Version& version) {
  std::ostringstream out;
  out << "VERITAS " << version.major << '.' << version.minor << '.'
      << version.patch << " (" << version.git_revision << ')';
  return out.str();
}

}  // namespace veritas
