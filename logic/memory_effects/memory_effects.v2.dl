// memory_effects.v2.dl -- the combined memory-effects rule bundle.
//
// One component evaluates the read and the write closure together over the
// same DirectCall/DirectRead/DirectWrite EDB, so the schema, the epistemic
// functor, the semantic-key functors, and the shared DirectCallKey helper are
// included exactly once here and the two domain bodies share them.

.include "../schema/relations.v2.dl"
.include "../common/epistemic.dl"
.include "../common/semantic_key.dl"

// Shared semantic-key helper. Both the MayWrite and MayRead witness rules cite
// DirectCall inputs, so the helper is declared once rather than re-declared in
// each body (Souffle rejects a duplicate relation declaration).
.decl DirectCallKey(call_site_id:CallSiteId, caller_id:FunctionId,
                    callee_id:FunctionId, dispatch:Dispatch,
                    epistemic:Epistemic, key:symbol)
DirectCallKey(cs, f, g, d, e,
  cat(@veritas_key_header_v1("DirectCall", 5),
  cat(@veritas_key_id_v1(css),
  cat(@veritas_key_id_v1(fs),
  cat(@veritas_key_id_v1(gs),
  cat(@veritas_key_field_enum_v1(d), @veritas_key_field_enum_v1(e))))))) :-
  DirectCall(cs, f, g, d, e), CallSiteMap(cs, css),
  FunctionMap(f, fs), FunctionMap(g, gs).

.include "may_write.v2.dl"
.include "may_read.v2.dl"
