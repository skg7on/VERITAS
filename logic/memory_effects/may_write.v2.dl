// may_write.v2.dl -- the MayWrite domain.
//
// Same three derivations as reachability: a direct write, a write reached
// through a call, and one reached through a successor SCC's support.
//
// MayWrite is keyed on the memory location alone and carries no byte range.
// That is why memory identity excludes the range: with the range folded into
// the id, two writes at different offsets in one object would derive two
// distinct MayWrite facts and "does f write object o" would have no single
// answer. DirectWrite keeps range_kind, offset, and size as its own columns.

.include "../schema/relations.v2.dl"
.include "../common/epistemic.dl"
.include "../common/semantic_key.dl"

.decl MayWrite(function_id:FunctionId, memory_id:MemoryId,
               epistemic:Epistemic)
.output MayWrite(IO=file, filename="MayWrite.csv")

// A member's own write, at its own warrant. The range columns are projected
// away here; they remain available on DirectWrite.
MayWrite(f, x, e) :- DirectWrite(f, x, _, _, _, e).

MayWrite(f, x, e) :-
  DirectCall(_, f, g, _, e1),
  MayWrite(g, x, e2),
  WeakenEpistemic(e1, e2, e).

MayWrite(f, x, e) :-
  DirectCall(_, f, g, _, e1),
  SupportMayWrite(g, x, e2),
  WeakenEpistemic(e1, e2, e).

// -- Semantic keys ---------------------------------------------------------

.decl MayWriteKey(function_id:FunctionId, memory_id:MemoryId,
                  epistemic:Epistemic, key:symbol)
MayWriteKey(f, x, e,
  cat(@veritas_key_header_v1("MayWrite", 3),
  cat(@veritas_key_id_v1(fs),
  cat(@veritas_key_id_v1(xs), @veritas_key_field_enum_v1(e))))) :-
  MayWrite(f, x, e), FunctionMap(f, fs), MemoryMap(x, xs).

.decl DirectWriteKey(function_id:FunctionId, memory_id:MemoryId,
                     range_kind:RangeKind, offset:number, size:unsigned,
                     epistemic:Epistemic, key:symbol)
DirectWriteKey(f, x, rk, off, sz, e,
  cat(@veritas_key_header_v1("DirectWrite", 6),
  cat(@veritas_key_id_v1(fs),
  cat(@veritas_key_id_v1(xs),
  cat(@veritas_key_field_enum_v1(rk),
  cat(@veritas_key_field_number_v1(off),
  cat(@veritas_key_field_unsigned_v1(sz),
      @veritas_key_field_enum_v1(e)))))))) :-
  DirectWrite(f, x, rk, off, sz, e), FunctionMap(f, fs), MemoryMap(x, xs).

.decl DirectCallKey(call_site_id:CallSiteId, caller_id:FunctionId,
                    callee_id:FunctionId, dispatch:Dispatch,
                    epistemic:Epistemic, key:symbol)
DirectCallKey(cs, f, g, d, e,
  cat(@veritas_key_header_v1("DirectCall", 5),
  cat(@veritas_key_id_v1(css),
  cat(@veritas_key_id_v1(fs),
  cat(@veritas_key_id_v1(gs),
  cat(@veritas_key_field_enum_v1(d), @veritas_key_field_enum_v1(e))))))) :-
  DirectCall(cs, f, g, d, e), CallSiteMap(cs, css),
  FunctionMap(f, fs), FunctionMap(g, gs).

.decl SupportMayWriteKey(function_id:FunctionId, memory_id:MemoryId,
                         epistemic:Epistemic, key:symbol)
SupportMayWriteKey(g, x, e,
  cat(@veritas_key_header_v1("SupportMayWrite", 3),
  cat(@veritas_key_id_v1(gs),
  cat(@veritas_key_id_v1(xs), @veritas_key_field_enum_v1(e))))) :-
  SupportMayWrite(g, x, e), FunctionMap(g, gs), MemoryMap(x, xs).

// -- Witnesses -------------------------------------------------------------
//
// `derivation_key` is the concatenation of the firing's input keys in ordinal
// order, so two ordinals of the same proof step share one key and alternative
// proofs stay distinct. The ordinal-0 and ordinal-1 rules bind the same body
// variables (including call site and dispatch) so they agree on the key.

Witness(rk, "wpa.memory.may_write.direct.v2", ik, ik, 0) :-
  DirectWrite(f, x, rkind, off, sz, e),
  MayWriteKey(f, x, e, rk),
  DirectWriteKey(f, x, rkind, off, sz, e, ik).

Witness(rk, "wpa.memory.may_write.transitive.v2", dk, dc_key, 0) :-
  DirectCall(cs, f, g, d, e1),
  MayWrite(g, x, e2),
  WeakenEpistemic(e1, e2, e),
  MayWriteKey(f, x, e, rk),
  DirectCallKey(cs, f, g, d, e1, dc_key),
  MayWriteKey(g, x, e2, rc_key),
  dk = cat(dc_key, rc_key).

Witness(rk, "wpa.memory.may_write.transitive.v2", dk, rc_key, 1) :-
  DirectCall(cs, f, g, d, e1),
  MayWrite(g, x, e2),
  WeakenEpistemic(e1, e2, e),
  MayWriteKey(f, x, e, rk),
  MayWriteKey(g, x, e2, rc_key),
  DirectCallKey(cs, f, g, d, e1, dc_key),
  dk = cat(dc_key, rc_key).

Witness(rk, "wpa.memory.may_write.support.v2", dk, dc_key, 0) :-
  DirectCall(cs, f, g, d, e1),
  SupportMayWrite(g, x, e2),
  WeakenEpistemic(e1, e2, e),
  MayWriteKey(f, x, e, rk),
  DirectCallKey(cs, f, g, d, e1, dc_key),
  SupportMayWriteKey(g, x, e2, rc_key),
  dk = cat(dc_key, rc_key).

Witness(rk, "wpa.memory.may_write.support.v2", dk, rc_key, 1) :-
  DirectCall(cs, f, g, d, e1),
  SupportMayWrite(g, x, e2),
  WeakenEpistemic(e1, e2, e),
  MayWriteKey(f, x, e, rk),
  SupportMayWriteKey(g, x, e2, rc_key),
  DirectCallKey(cs, f, g, d, e1, dc_key),
  dk = cat(dc_key, rc_key).
