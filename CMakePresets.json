{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "VERITAS (Ninja, Debug)",
      "description": "Ninja generator, build/ under repo root, Debug, compile_commands exported.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "homebrew-clang",
      "inherits": "default",
      "displayName": "VERITAS (Ninja, Debug, Homebrew Clang)",
      "description": "Debug build with Homebrew's /opt/homebrew/bin/clang and clang++ as the host toolchain. Uses build-homebrew-clang/ so it can coexist with the default preset's build/ tree. The top-level CMakeLists applies the LLVM 20 <random> compatibility definition automatically when the compiler needs it.",
      "binaryDir": "${sourceDir}/build-homebrew-clang",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/opt/homebrew/bin/clang",
        "CMAKE_CXX_COMPILER": "/opt/homebrew/bin/clang++"
      }
    },
    {
      "name": "debug",
      "inherits": "default",
      "displayName": "VERITAS Debug",
      "description": "Debug build. Same binaryDir as default.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "default",
      "displayName": "VERITAS Release",
      "description": "Release build. Same binaryDir as default.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "static-release",
      "inherits": "release",
      "displayName": "VERITAS Static Release",
      "description": "Release build with static libraries (BUILD_SHARED_LIBS=OFF).",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "displayName": "Build (default)"
    },
    {
      "name": "homebrew-clang",
      "configurePreset": "homebrew-clang",
      "displayName": "Build (homebrew-clang)"
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "displayName": "Build (debug)"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "displayName": "Build (release)"
    },
    {
      "name": "static-release",
      "configurePreset": "static-release",
      "displayName": "Build (static-release)"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "displayName": "Test (default)",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "debug",
      "inherits": "default",
      "configurePreset": "debug",
      "displayName": "Test (debug)"
    },
    {
      "name": "homebrew-clang",
      "inherits": "default",
      "configurePreset": "homebrew-clang",
      "displayName": "Test (homebrew-clang)"
    }
  ]
}
